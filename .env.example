# Copy this file to .env and change the values you need.
# All values are optional. The ones shown here are the defaults.

# Database
PLUMMET_DATABASE_URL=sqlite:///data/plummet.db

# Telegram (get a token from @BotFather)
PLUMMET_TELEGRAM_BOT_TOKEN=
PLUMMET_TELEGRAM_CHAT_ID=

# Scraping
PLUMMET_REQUEST_TIMEOUT=15
PLUMMET_MAX_RETRIES=3

# How often to check prices (minimum 5 minutes)
PLUMMET_CHECK_INTERVAL_MINUTES=30

# Send an alert when the price goes down at least this percent
PLUMMET_MIN_DROP_PERCENT=5

# DEBUG, INFO, WARNING or ERROR
PLUMMET_LOG_LEVEL=INFO
